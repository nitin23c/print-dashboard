# Copy to .env and fill in. Never commit .env.

# The CUPS admin login. Both containers read these two lines.
CUPSADMIN=printadmin
CUPSPASSWORD=change-this-to-a-long-random-password

# Your timezone, used for "today" and "this month" totals.
TZ=UTC

# Your printer's address on the network. Leave empty to watch only the queue.
PRINTER_IP=

# Only for compose.dashboard-only.yml: where CUPS is running.
# CUPS_URL=http://192.0.2.10:631
